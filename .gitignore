# ============================================================
# EcoExtract — .gitignore
# ============================================================
# Tells Git which files/folders to skip when committing.
# This keeps your repo clean and free of machine-specific or
# generated files that would confuse judges or other devs.
# ============================================================


# ─────────────────────────────────────────────────────────
# Node.js / npm
# ─────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
npm-debug.log
yarn-debug.log*
yarn-error.log*
yarn.lock
package-lock.json
.pnpm-debug.log*
.pnpm-store/
*.tgz
.npm
.npmrc


# ─────────────────────────────────────────────────────────
# Environment variables & secrets
# ─────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
*.env
!.env.example
secrets.json
credentials.json
config.local.js


# ─────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/


# ─────────────────────────────────────────────────────────
# Cloudflare Workers / Wrangler
# ─────────────────────────────────────────────────────────
.wrangler/
worker-configuration.d.ts
.dev.vars


# ─────────────────────────────────────────────────────────
# Editors & IDEs
# ─────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project


# ─────────────────────────────────────────────────────────
# Operating system files
# ─────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini


# ─────────────────────────────────────────────────────────
# Logs
# ─────────────────────────────────────────────────────────
*.log
logs/
log/
*.log.*
!important.log


# ─────────────────────────────────────────────────────────
# Build artifacts & caches
# ─────────────────────────────────────────────────────────
dist/
build/
out/
.cache/
.parcel-cache/
.next/
.nuxt/
.svelte-kit/
.vercel/
.output/
.temp/
tmp/
temp/


# ─────────────────────────────────────────────────────────
# Test coverage & reports
# ─────────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov
junit.xml
test-results/


# ─────────────────────────────────────────────────────────
# Database files (if you later add a local DB)
# ─────────────────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db
*.db-journal


# ─────────────────────────────────────────────────────────
# Misc
# ─────────────────────────────────────────────────────────
*.bak
*.orig
*.rej
*.tmp
*.cache
*.pid
*.seed
*.pid.lock
.eslintcache
.stylelintcache
.DS_Store
*.swp


# ─────────────────────────────────────────────────────────
# Keep these tracked (negations)
# ─────────────────────────────────────────────────────────
!README.md
!LICENSE
!frontend/index.html
!frontend/terminal.html
!frontend/styles.css
!frontend/app.js
!backend/server.js
!backend/package.json
!edge/main.py
